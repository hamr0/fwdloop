diff --git a/src/ticket-mcp.js b/src/ticket-mcp.js
new file mode 100644
index 0000000..e45145a
--- /dev/null
+++ b/src/ticket-mcp.js
@@ -0,0 +1,24 @@
+// F100 scratch: read ONE GitHub issue through the signed MCP server (allow = exactly the signed tools), never any other tool.
+import { createMCPBridge } from 'bare-agent/mcp';
+import { homedir } from 'node:os';
+import { join } from 'node:path';
+
+export const SIGNED_TOOLS = ['issue_read'];
+export async function fetchTicketMcp(url, { log } = {}) {
+  const m = /^https:\/\/github\.com\/([^/]+)\/([^/]+)\/issues\/(\d+)\/?$/.exec(String(url).trim());
+  if (!m) return { ok: false, error: `${url} is not a GitHub issue address` };
+  let bridge;
+  try {
+    bridge = await createMCPBridge({ configPaths: [join(homedir(), '.mcp.json')], timeout: 90000, callTimeout: 90000, confirmServer: () => true, allow: { github: SIGNED_TOOLS } });
+    const tools = bridge.tools.map((t) => t.name);
+    log?.({ exposed: tools, missing: bridge.missing });
+    const tool = bridge.tools.find((t) => t.name === 'github_issue_read');
+    if (!tool || tools.length !== 1) return { ok: false, error: `signed tool issue_read is not exposed alone (exposed: ${tools.join(', ') || 'none'})` };
+    log?.({ call: 'issue_read', owner: m[1], repo: m[2], issue_number: Number(m[3]) });
+    const r = await tool.execute({ method: 'get', owner: m[1], repo: m[2], issue_number: Number(m[3]) });
+    const text = typeof r === 'string' ? r : (r?.content ?? []).map((c) => c.text ?? '').join('');
+    if (!text) return { ok: false, error: `issue_read returned nothing for ${url}` };
+    return { ok: true, text, url };
+  } catch (e) { return { ok: false, error: `MCP read of ${url} failed: ${String(e?.message).slice(0, 200)}` }; }
+  finally { try { await bridge?.close(); } catch { /* closed */ } }
+}
