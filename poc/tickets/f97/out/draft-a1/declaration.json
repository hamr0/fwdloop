    {
      "primitives": [
        "write"
      ],
      "reads": [
        "accepted_plan"
      ],
      "emits": "plan_written",
      "fromLine": 5,
      "close": {
        "class": "hitl"
      },
      "goal": "and once I accept, write it out."
    }
  ],
  "inputFacts": {}
