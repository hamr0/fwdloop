    {
      "primitives": [
        "write"
      ],
      "reads": [
        "accepted_plan"
      ],
      "emits": "written_response_plan",
      "fromLine": 5,
      "close": {
        "class": "hitl"
      },
      "goal": "and once I accept, write it out."
    }
  ],
