node_modules/
.env
*.env
!.env.example
/types/
*.log
*.db

# Flow directories and probe scratch are never committed
flows/
scratch-*

# Agent / IDE / tooling scratch — ignore EVERY dot-directory by default,
# then re-admit only the ones we ship. Default-deny beats chasing each new scratch dir.
.*/
!.github/
# The rules file is the one thing under .claude/ that ships with the repo
!.claude/
.claude/*
!.claude/remember/
.claude/remember/*
!.claude/remember/AGENT_RULES.md

# docs-builder machine state
docs/.docs-builder/

# M0 POC run output — never committed except the spend tally
poc/m0/out/*
!poc/m0/out/spend.jsonl
