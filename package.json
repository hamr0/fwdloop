{
  "name": "fwdloop",
  "version": "0.4.0",
  "description": "Describe a job as steps and guardrails; an agent builds the workflow, pauses for humans where you said, checks every step happened, and reruns it under budgets it cannot touch.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "license": "Apache-2.0",
  "author": "hamr0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamr0/fwdloop.git"
  },
  "homepage": "https://github.com/hamr0/fwdloop#readme",
  "bugs": {
    "url": "https://github.com/hamr0/fwdloop/issues"
  },
  "keywords": [
    "agent",
    "workflow",
    "automation",
    "human-in-the-loop",
    "bare-suite"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc",
    "prepack": "npm run build:types"
  },
  "files": [
    "src",
    "types",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "bare-agent": "^0.42.0",
    "bareguard": "^0.15.0",
    "litectx": "^0.32.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.20.4"
  }
}
