#!/usr/bin/env node
// M3 piece 2 (docs/wiki/the-module-ladder.md, "M3 — scope, exit, negative —
// SIGNED", scope item 9): the CLI. Stdlib only (`node:util` `parseArgs`),
// no new dependency. Four verbs — `run`, `inbox`, `answer`, `resume` — wired
// from `src/` only (this file never imports from `poc/`; the live pieces
// here are the same ones `poc/m2/live.mjs` proved: `makeLiveModelStep`,
// `sendViaPrimitive`, `resolvePrimitives`, `checkKeyPreflight`).
//
// borrowed-from: fwdloop poc/m2/live.mjs@748359d (the live-run wiring shape:
// preflight the key before touching a run dir, predict the frozen input
// paths so `resolvePrimitives` can build sandboxed tools before `runFlow`
// itself freezes anything, drive `runFlow`/`sendViaPrimitive` for real).
// Rewritten as the shipped, four-verb CLI (park-and-exit instead of an
// in-process wait, plus `inbox`/`answer`/`resume`) — src/ never imports
// from poc/, and poc/ is not part of the published package.

import { parseArgs } from 'node:util';
import {
  existsSync, readdirSync, realpathSync, rmdirSync,
} from 'node:fs';
import { extname, join, resolve } from 'node:path';
import { pathToFileURL } from 'node:url';

import {
  readFlow, checkFlowName, resolveRunDir, listFlowNames, listRunIds, readFileInside, claimRunId,
} from '../src/flow.js';
import { loadCatalogue } from '../src/catalogue.js';
import {
  runFlow, resumeRun, continueRun, auditSpend, makeParkingAskStep, readAsk, readRunState,
} from '../src/runner.js';
import { applyRunValues, pickRunValues, dropUnstartedValues } from '../src/runvalues.js';
import { makeLiveModelStep } from '../src/model-step.js';
import { sendViaPrimitive } from '../src/send.js';
import { resolvePrimitives } from '../src/primitives.js';
import {
  checkKeyPreflight, resolveUsableModel, pickTicked, readPriceConfig, ceilingCostUsd,
} from '../src/provider.js';
import { readModelRecord } from '../src/flowmodel.js';
import { configDoorHome } from '../src/config.js';
import {
  claimHold, settleHold, nameRunDir, monthlyRefusalText, ConfigError,
} from '../src/monthly.js';
import { keysForDoor } from '../src/keysfile.js';
import {
  answerAsk, readAskEvidence, normalizeDecision, stripControl, withReopen,
} from '../src/ask.js';
import { panelMain } from '../src/panel/server.js';
import { isInteractive, confirmTypedName, NEEDS_TTY } from '../src/sign-confirm.js';
import { draftToDir, draftKeyRefusal, signDraft, SIGN_LINE, costText, questionsRefusal } from '../src/authoring.js';
import { userInfo } from 'node:os';

// This CLI drives no fixed provider (M4d amendment 6). A job runs with the model recorded beside it (`model.json`, written when it was drafted:
// the provider is the name of a key, its key is read from the env under that name and never printed); `draft` takes `--model` (+ `--provider`).
// Whether that model may be used is `resolveUsableModel` (ticked in Settings > Providers with both prices): this file names no model and no price.

/**
 * M4d: the ONE place a keyed command gets its env — the shell env with the keys file
 * (`~/.config/fwdloop/.env`) filling what the shell leaves unset, loaded once at command
 * start. A file other users can read is refused here (ruling 1A), before any dir or ledger
 * write, at $0. process.env is never mutated: the merged env is handed down by hand.
 */
function keyedLoad() {
  const loaded = keysForDoor();
  if (!loaded.ok) fail(String(loaded.refusal));
  return loaded;
}
const keyedEnv = () => keyedLoad().env;

/**
 * M4d piece 3: the monthly check, at the ONE seam all three money doors (`run`, `resume`, `draft`) call,
 * before any spend and before any ledger write. No limit set = a $0 hold row (so the run's spend is counted once a limit is set), no check;
 * a test process with no config home = no row at all. A broken config.json or an unwritable record refuses by name, never "no limit". A hold
 * that does not fit refuses at $0 with the one refusal text. A hold that fits is given back when this
 * process ends or parks (the `exit` hook runs on every exit path; a SIGKILL leaves it for the next check,
 * which settles it as "process gone").
 * @returns {{ addRunDir: (d: string) => void, nameRunDir: (d: string) => void }}
 */
const NO_CONFIG_HOME_REFUSAL = 'NODE_ENV=test is set without FWDLOOP_CONFIG_HOME, so the keys file, prices and monthly limit would be skipped. Nothing spent. Unset NODE_ENV, or set FWDLOOP_CONFIG_HOME.';

function takeMonthlyHold({ what, flow, runId, runDir, holdUsd, spentAtHold = 0 }) {
  const door = configDoorHome();
  const home = door.home;
  const also = [];
  if (door.skip) {
    // A test process with no config home skips the money checks. Only an injected test hook may do that;
    // a real provider call here would spend with no keys file, prices, limit or record.
    const hook = what === 'draft' ? 'FWDLOOP_TEST_DRAFT_PROVIDER' : 'FWDLOOP_TEST_MODEL_STEP';
    if (!(process.env.NODE_ENV === 'test' && process.env[hook])) {
      fail(NO_CONFIG_HOME_REFUSAL);
    }
    return { addRunDir: () => {}, nameRunDir: () => {} };
  }
  let claim;
  try {
    claim = claimHold({
      what, flow, runId, runDir, holdUsd, spentAtHold, home,
    });
  } catch (err) {
    if (!(err instanceof ConfigError)) throw err;
    fail(`${err.message} — refusing to start rather than guess the monthly limit. Nothing spent.`);
  }
  if (!claim.ok) fail(monthlyRefusalText(claim.room));
  if (claim.holdId !== null) {
    process.on('exit', () => settleHold({
      holdId: claim.holdId, why: process.exitCode ? 'ended (red)' : 'ended or parked', home, alsoRunDirs: also,
    }));
  }
  return {
    addRunDir: (d) => also.push(d),
    // C2: a rerun's new run dir is named in the money record the moment it starts.
    nameRunDir: (d) => { also.push(d); nameRunDir({ holdId: claim.holdId, runDir: d, home }); },
  };
}

/** The new runs a `rerun` chain started in this process — their spend belongs to this hold's month too. */
function rerunDirs(result, flowDir) {
  const dirs = [];
  for (let r = result; r && r.outcome === 'rerun'; r = r.newRun) dirs.push(join(flowDir, 'runs', r.newRunId));
  return dirs;
}

function fail(message) {
  process.stderr.write(`fwdloop: ${message}\n`);
  process.exit(1);
}

/**
 * The ONE place a human-typed `--root` becomes a path (hamr ruling
 * 2026-09-29): resolved to its real path once, at command start. Nothing
 * inside the root is ever followed; that stays under bareguard's symlink
 * refusal.
 */
function resolveRoot(cmd, given) {
  try {
    return realpathSync(resolve(given));
  } catch (err) {
    if (err.code === 'ENOENT') fail(`${cmd}: --root "${given}" does not exist`);
    fail(`${cmd}: --root "${given}" cannot be resolved: ${err.code ?? err.message}`);
  }
}

function today() {
  return new Date().toISOString().slice(0, 10);
}

/**
 * Build the run's `modelStep` and its per-round hold (`{ modelStep, ceilingUsd }`). Live by default (`makeLiveModelStep` against
 * the job's recorded provider, refusing an unset/empty/whitespace key via
 * `checkKeyPreflight` BEFORE this function returns — i.e. before the caller
 * has created a run dir or written any book row).
 *
 * Test-only escape hatch, never a user-facing flag: active ONLY when BOTH
 * `NODE_ENV==='test'` AND `FWDLOOP_TEST_MODEL_STEP` (a module path) are set.
 * A live invocation of this CLI is never launched with `NODE_ENV=test`, so
 * there is no way to reach a fake model in production; and setting
 * `FWDLOOP_TEST_MODEL_STEP` alone (without `NODE_ENV=test`) does nothing —
 * two independent gates, neither of them a documented option, so it cannot
 * be hit by a user typing `--something`. This is how the test suite drives
 * every CLI scenario at $0 with zero chance of a real network call.
 */
async function resolveModelStep(spendPath, env, flowDir, named = {}) {
  if (process.env.NODE_ENV === 'test' && process.env.FWDLOOP_TEST_MODEL_STEP) {
    const modulePath = resolve(process.env.FWDLOOP_TEST_MODEL_STEP);
    const mod = await import(pathToFileURL(modulePath).href);
    if (typeof mod.default !== 'function') {
      throw new Error(`FWDLOOP_TEST_MODEL_STEP module "${modulePath}" has no default export function`);
    }
    // A test double has no model of its own. When Settings has one model ticked with both prices its hold applies (so a cap-halt
    // is exercised the way a live run's is); with none, the double holds nothing. It is never refused here: it spends nothing.
    const modelStep = await mod.default({ spendPath });
    let usable = null;
    try {
      const rec = configDoorHome().skip ? null : readModelRecord(flowDir);
      usable = rec === null ? null : resolveUsableModel(rec.slot, { config: readPriceConfig(), model: rec.model });
    } catch (err) {
      if (!(err instanceof ConfigError)) throw err; // a broken config is refused by name at the monthly hold, right after this
    }
    return { modelStep, ...(usable?.ok ? { ceilingUsd: ceilingCostUsd(usable.rates) } : {}) };
  }
  // A test process with no config home reads no Settings: say why, not "tick a model".
  if (configDoorHome().skip) throw new Error(NO_CONFIG_HOME_REFUSAL);
  // The ONE decision of which model runs and at what price (M4d amendments 5 and 6): the model recorded with the job (a job drafted before the record
  // existed takes `--model`), refused by name, at $0, before a run dir or a book row exists. The per-round hold is that model's own Settings price times the token bounds.
  let usable;
  let slot;
  try {
    const config = readPriceConfig();
    const rec = readModelRecord(flowDir);
    if (rec !== null && named.model !== undefined && (named.model !== rec.model || (named.provider !== undefined && named.provider !== rec.slot))) {
      throw new Error(`This job already has its model recorded (${rec.slot} · ${rec.model}); --model cannot change it.`);
    }
    let pick = rec;
    if (pick === null) {
      if (named.model === undefined) throw new Error('This job has no model recorded. Name one with --model <id>, a model ticked in Settings > Providers with both prices.');
      const p = pickTicked(config, named);
      if (!p.ok) throw new Error(p.say);
      pick = p;
    }
    slot = pick.slot;
    const keyCheck = checkKeyPreflight(slot, env);
    if (!keyCheck.ok) throw new Error(keyCheck.message);
    usable = resolveUsableModel(slot, { config, model: pick.model });
  } catch (err) {
    if (!(err instanceof ConfigError)) throw err;
    throw new Error(`${err.message} — refusing to start rather than guess the price. Nothing spent.`);
  }
  if (!usable.ok) throw new Error(usable.say);
  return {
    modelStep: makeLiveModelStep({ slot, model: usable.model, spendPath, env }),
    ceilingUsd: ceilingCostUsd(usable.rates),
  };
}

function parseSourceFlags(list) {
  const out = {};
  for (const entry of list ?? []) {
    const eq = entry.indexOf('=');
    if (eq <= 0) throw new Error(`--source "${entry}" is not "role=path"`);
    const role = entry.slice(0, eq);
    const value = entry.slice(eq + 1);
    if (value.length === 0) throw new Error(`--source "${entry}" has an empty path`);
    out[role] = resolve(value);
  }
  return out;
}

// F48 round 3 (docs/logs/FINDINGS.md): this CLI must never build a run path
// by hand — every flow/runId it walks goes through `listFlowNames`/
// `listRunIds`/`resolveRunDir` (`src/flow.js`, the same checked builders
// `src/panel/data.js` already uses), and every `ask.json` it reads goes
// through `readAsk` (`src/runner.js`, itself routed through
// `readFileInside`) — never a private `join()` + raw `readFileSync`. Closes
// the CLI-side half of F48: a symlinked flow/run/ask.json (or a hand-placed
// directory whose name would fail `checkFlowName`/`checkRunId`) is skipped
// here exactly as it already is by the panel, instead of being followed.
function findRunDirByAskId(root, askId) {
  for (const flow of listFlowNames(root)) {
    const flowDir = join(root, flow);
    for (const runId of listRunIds(flowDir)) {
      const resolved = resolveRunDir(flowDir, runId);
      if (!resolved.ok) continue; // eslint-disable-line no-continue
      const ask = readAsk(resolved.runDir);
      if (ask && ask.askId === askId) return resolved.runDir;
    }
  }
  return null;
}

/** Reports a `runFlow`/`resumeRun` result to stdout/stderr and sets the
 *  process exit code. A `rerun` outcome also reports the new run it just
 *  started (recursively — the new run may itself be paused/complete/a red),
 *  so a human watching a `run`/`resume` invocation sees the WHOLE chain,
 *  never just the old run's own half of it. */
function reportRunResult(result, { rootArg }) {
  if (result.outcome === 'paused') {
    process.stdout.write(`parked: askId=${result.askId} expiresAt=${result.expiresAt} spentUsd=${result.spentUsd}\n`);
    process.stdout.write(`fwdloop answer ${result.askId} accept|redo "<reason>"|rerun "<reason>" --root ${rootArg}\n`);
    return;
  }
  if (result.outcome === 'complete') {
    process.stdout.write(`complete: spentUsd=${result.spentUsd}\n`);
    return;
  }
  if (result.outcome === 'rerun') {
    process.stdout.write(`rerun: oldRunId=${result.runId} newRunId=${result.newRunId} spentUsd=${result.spentUsd}\n`);
    reportRunResult(result.newRun, { rootArg });
    return;
  }
  if (result.outcome === 'stopped') {
    process.stdout.write(`stopped: spentUsd=${result.spentUsd} — ${result.red}\n`);
    return;
  }
  if (result.outcome === 'ask-expired') {
    process.stderr.write(`fwdloop: ask-expired — run cancelled, spentUsd=${result.spentUsd}\n`);
    process.exitCode = 1;
    return;
  }
  process.stderr.write(`fwdloop: ${result.outcome}${result.red ? ` — ${result.red}` : ''}\n`);
  process.exitCode = 1;
}

// ---------------------------------------------------------------------------
// run
// ---------------------------------------------------------------------------

async function cmdRun(rest) {
  const { values, positionals } = parseArgs({
    args: rest,
    options: {
      root: { type: 'string' },
      source: { type: 'string', multiple: true, default: [] },
      'run-id': { type: 'string' },
      // a job drafted before its model was recorded: the model it runs with (a ticked line); --provider only if two keys tick the same id
      model: { type: 'string' }, provider: { type: 'string' },
    },
    allowPositionals: true,
  });
  const env = keyedEnv();

  const flowName = positionals[0];
  if (!flowName) fail('run: a flow name is required — fwdloop run <flow> --root <dir> --source <role>=<path> ...');
  if (!values.root) fail('run: --root <dir> is required');

  const root = resolveRoot('run', values.root);
  const nameCheck = checkFlowName(flowName);
  if (!nameCheck.ok) fail(nameCheck.red);

  const loaded = loadCatalogue();
  if (!loaded.ok) fail(`catalogue: ${loaded.reds.join('; ')}`);
  const catalogue = loaded.primitives;

  const read = readFlow({ root, name: flowName, catalogue });
  if (!read.ok) fail(`flow "${flowName}": ${read.reds.join('; ')}`);
  const { declaration } = read;

  let parsedSources;
  try {
    parsedSources = parseSourceFlags(values.source);
  } catch (err) {
    fail(`run: ${err.message}`);
    return;
  }
  const declaredRoles = (read.arbiter.sources ?? []).map((s) => s.role);
  for (const role of declaredRoles) {
    if (!Object.hasOwn(parsedSources, role)) {
      fail(`run: flow "${flowName}" declares source role "${role}" — pass --source ${role}=<path>`);
    }
  }
  for (const role of Object.keys(parsedSources)) {
    if (!declaredRoles.includes(role)) {
      fail(`run: --source role "${role}" is not declared by flow "${flowName}" (known roles: ${declaredRoles.join(', ') || '(none)'})`);
    }
  }
  const sources = declaredRoles.map((role) => ({ id: role, path: parsedSources[role] }));
  for (const src of sources) {
    if (!existsSync(src.path)) fail(`run: source "${src.id}" is unreadable at ${src.path}`);
  }

  // M4e amendment 3: no --run-id -> the ONE claim (`run-<n>`, the folder created exclusively). A typed id is checked as before; its
  // folder may already exist ONLY if empty — that is a name the panel just claimed for this very start, it holds no run.
  let runId = values['run-id'];
  /** @type {string} */
  let runDir;
  if (runId === undefined) {
    const claimed = claimRunId(join(root, flowName));
    if (!claimed.ok) fail(claimed.red);
    runId = claimed.runId;
    runDir = claimed.runDir;
  } else {
    const runIdCheck = resolveRunDir(join(root, flowName), runId);
    if (!runIdCheck.ok) fail(runIdCheck.red);
    runDir = runIdCheck.runDir;
    // M4e amendment 5: the panel's Sign & run puts the run's signed values in the folder BEFORE the start; that one file is not "a run".
    if (existsSync(runDir) && readdirSync(runDir).filter((n) => n !== 'signed-values.json').length > 0) fail(`run: run dir "${runDir}" already exists — use a new --run-id`);
  }
  // M4e amendment 5 item 3: the cap this run was signed with (its own values file, else the flow's) is what the monthly hold is for.
  const applied = applyRunValues(read.arbiter, flowName, read.signature.flow, pickRunValues(runDir));
  if (!applied.ok) fail(`run: ${applied.red}`);
  const { arbiter } = applied;
  // a refusal before the run starts must not leave the claimed empty folder behind (rmdir only ever removes an EMPTY folder)
  process.on('exit', () => { dropUnstartedValues(runDir); try { rmdirSync(runDir); } catch { /* not empty, or gone: nothing to undo */ } });

  // The key preflight (item A: "refuses at $0 BEFORE any book write") runs
  // here — before ANY directory for this run is created.
  const spendPath = join(runDir, 'spend.jsonl');
  let modelStep;
  let ceilingUsd;
  try {
    ({ modelStep, ceilingUsd } = await resolveModelStep(spendPath, env, join(root, flowName), values));
  } catch (err) {
    fail(err.message);
    return;
  }

  // M4d piece 3: the monthly check — the hold is the flow's signed per-run cap. Before the run dir exists
  // (runFlow makes it), so a refusal leaves only the refused rows in runs.jsonl.
  const hold = takeMonthlyHold({
    what: 'run', flow: flowName, runId, runDir, holdUsd: arbiter.capUsd,
  });

  // Predict the frozen input paths `runFlow`'s own `freezeInputs` will use
  // (deterministic: `<runDir>/inputs/<id><ext>`) so the primitives map can
  // be built once, before `runFlow` itself freezes anything. Pure path
  // arithmetic — `resolvePrimitives` only needs the STRINGS, never the
  // directory to actually exist yet — so nothing under `runDir` is created
  // here. `runFlow` itself now carries the F46 unwired-verb preflight
  // refusal (moved to `src/runner.js` so any caller — this CLI, M4's web
  // panel — gets it for free); it also owns the ONLY `mkdirSync`/
  // `freezeInputs` for this run dir, so a refusal leaves nothing behind.
  const predictedInputs = sources.map((s) => ({ id: s.id, frozen: join(runDir, 'inputs', `${s.id}${extname(s.path)}`) }));
  const allVerbs = [...new Set(declaration.steps.flatMap((s) => s.primitives ?? []))];
  const { tools: primitives, reds: primitiveReds } = resolvePrimitives(catalogue, allVerbs, { runDir, inputs: predictedInputs });

  const result = await runFlow({
    root,
    name: flowName,
    runId,
    sources,
    catalogue,
    modelStep,
    ceilingUsd,
    askStep: makeParkingAskStep(),
    sendStep: sendViaPrimitive,
    primitives,
    primitiveReds,
    businessDate: today(),
  });

  for (const d of rerunDirs(result, join(root, flowName))) hold.addRunDir(d);
  reportRunResult(result, { rootArg: values.root });
}

// ---------------------------------------------------------------------------
// inbox
// ---------------------------------------------------------------------------

function cmdInbox(rest) {
  const { values } = parseArgs({
    args: rest,
    options: { root: { type: 'string' } },
  });
  const root = resolveRoot('inbox', values.root ?? '.');

  const rows = [];
  // F48 round 3: flow/run identity is walked via `listFlowNames`/
  // `listRunIds`/`resolveRunDir` (never a private `join()`), and `ask.json`
  // is read via `readFileInside` (both `src/flow.js`) — a symlinked
  // ask.json, or a symlinked run/flow dir, is treated as "missing" here,
  // never followed.
  for (const flow of listFlowNames(root)) {
    const flowDir = join(root, flow);
    for (const runId of listRunIds(flowDir)) {
      const resolved = resolveRunDir(flowDir, runId);
      if (!resolved.ok) continue; // eslint-disable-line no-continue
      const runDir = resolved.runDir;
      const askRead = readFileInside(runDir, 'ask.json');
      if (!askRead.ok) continue; // eslint-disable-line no-continue -- missing (or refused) ask.json: nothing to show
      let ask;
      try {
        ask = withReopen(runDir, JSON.parse(askRead.text)); // the effective deadline (a reopened ask's new one)
      } catch (err) {
        // A malformed/unparseable ask.json must never crash inbox — show it
        // naming the run as unreadable and move on to the next one.
        rows.push({ flow, runId, status: 'unreadable', detail: `ask.json could not be parsed — ${err.message}` });
        // eslint-disable-next-line no-continue
        continue;
      }
      // An M2-era ask.json carries no `askId`/`expiresAt` (this CLI's
      // answer/resume verbs can't act on it — they key everything off
      // `askId`). Shown as "legacy (not answerable)", never "open": an ask
      // this CLI cannot answer must never be reported as one it can.
      if (typeof ask.askId !== 'string' || typeof ask.expiresAt !== 'string') {
        rows.push({ flow, runId, status: 'legacy', question: ask.question });
        // eslint-disable-next-line no-continue
        continue;
      }
      // Signed item 6: expiry is checked whenever anyone touches the run —
      // for `inbox` that means SHOWING an expired ask, never cancelling it
      // (cancelling happens only at answer/resume, which re-verify anyway).
      // Consumed-marker check also goes through `readFileInside` — a
      // symlinked consumed marker is treated as "not consumed" (still shown
      // as open/expired), never as proof the ask was answered.
      if (readFileInside(runDir, `answer.${ask.askId}.consumed.json`).ok) continue; // eslint-disable-line no-continue -- this specific ask is already answered
      // A present-but-unparseable expiresAt (Date.parse -> NaN) must never
      // read as "not expired" — `Date.now() > NaN` is false, so the naive
      // compare below would show this as [open] with a "NaNs left"
      // countdown. Shown as [unreadable] naming the run instead, same as a
      // malformed ask.json — never [open], never a NaN countdown.
      if (Number.isNaN(Date.parse(ask.expiresAt))) {
        rows.push({
          flow, runId, status: 'unreadable', detail: `ask.json expiresAt "${ask.expiresAt}" is not a parseable date`,
        });
        // eslint-disable-next-line no-continue
        continue;
      }
      const expired = Date.now() > Date.parse(ask.expiresAt);
      const timeLeftMs = Date.parse(ask.expiresAt) - Date.now();
      rows.push({
        askId: ask.askId, flow, runId, question: ask.question, status: expired ? 'expired' : 'open', timeLeftMs,
      });
    }
  }

  if (rows.length === 0) {
    process.stdout.write('inbox: no open asks\n');
    return;
  }
  for (const row of rows) {
    if (row.status === 'unreadable') {
      process.stdout.write(`flow=${row.flow} run=${row.runId} [unreadable] ${row.detail}\n`);
      continue;
    }
    if (row.status === 'legacy') {
      process.stdout.write(`flow=${row.flow} run=${row.runId} [legacy (not answerable)] — ${stripControl(row.question)}\n`);
      continue;
    }
    const timeLeft = row.status === 'expired' ? 'expired' : `${Math.max(0, Math.round(row.timeLeftMs / 1000))}s left`;
    process.stdout.write(`${row.askId}  flow=${row.flow} run=${row.runId} [${row.status}] ${timeLeft} — ${stripControl(row.question)}\n`);
  }
}

// ---------------------------------------------------------------------------
// show — read-only: prints a parked ask's question, expiry, and evidence
// (the artifact under review, then each unjudged artifact labelled by
// step). F45 finding 2's other half: `inbox` says an ask is open, `show`
// is how a human actually sees what they'd be accepting. Never writes.
// ---------------------------------------------------------------------------

function cmdShow(rest) {
  const { values, positionals } = parseArgs({
    args: rest,
    options: { root: { type: 'string' } },
    allowPositionals: true,
  });
  const [askId] = positionals;
  if (!askId) fail('show: an askId is required — fwdloop show <askId> --root <dir>');

  const root = resolveRoot('show', values.root ?? '.');
  const runDir = findRunDirByAskId(root, askId);
  if (!runDir) fail(`show: no open ask found for askId "${askId}" under ${root}`);

  // F48 round 3: routed through `readFileInside` (`src/flow.js`) — a
  // symlinked ask.json is refused by name here, never read through.
  const askRead = readFileInside(runDir, 'ask.json');
  if (!askRead.ok) {
    fail(askRead.missing
      ? `show: no ask.json for askId "${askId}"`
      : `show: ask.json for askId "${askId}" — ${askRead.red}`);
    return;
  }
  let ask;
  try {
    ask = withReopen(runDir, JSON.parse(askRead.text)); // the effective deadline (a reopened ask's new one)
  } catch (err) {
    fail(`show: ask.json for askId "${askId}" is not valid JSON — ${err.message}`);
    return;
  }

  process.stdout.write(`question: ${stripControl(ask.question)}\n`);
  process.stdout.write(`expiresAt: ${ask.expiresAt}\n`);

  const { draft, unjudged, why } = readAskEvidence(ask);
  if (!draft) {
    process.stdout.write(`\n(no evidence recorded on this ask — ${why})\n`);
    return;
  }
  process.stdout.write('\n--- artifact under review ---\n');
  process.stdout.write(`${stripControl(draft.text)}\n`);
  for (const item of unjudged) {
    process.stdout.write(`\n--- unjudged: ${stripControl(item.step)} ---\n`);
    process.stdout.write(`${stripControl(item.text)}\n`);
  }
}

// ---------------------------------------------------------------------------
// answer
// ---------------------------------------------------------------------------

function cmdAnswer(rest) {
  const { values, positionals } = parseArgs({
    args: rest,
    options: { root: { type: 'string' } },
    allowPositionals: true,
  });
  const [askId, decision, reason] = positionals;
  if (!askId) fail('answer: an askId is required — fwdloop answer <askId> accept|redo "<reason>"|rerun "<reason>"');
  if (!decision) fail(`answer: a decision (accept|redo|rerun) is required for askId "${askId}"`);

  const root = resolveRoot('answer', values.root ?? '.');
  const runDir = findRunDirByAskId(root, askId);
  if (!runDir) fail(`answer: no open ask found for askId "${askId}" under ${root}`);

  const result = answerAsk({
    runDir, askId, decision, reason,
  });
  if (!result.ok) fail(result.red);

  process.stdout.write(`answered: askId=${askId} decision=${normalizeDecision(decision)}\n`);
}

// ---------------------------------------------------------------------------
// resume
// ---------------------------------------------------------------------------

async function cmdResume(rest) {
  const { values, positionals } = parseArgs({
    args: rest,
    options: {
      flow: { type: 'string' },
      root: { type: 'string' },
      model: { type: 'string' }, provider: { type: 'string' },
    },
    allowPositionals: true,
  });
  const env = keyedEnv();
  const runId = positionals[0];
  if (!runId) fail('resume: a runId is required — fwdloop resume <runId> --flow <name> --root <dir>');
  if (!values.flow) fail('resume: --flow <name> is required');
  if (!values.root) fail('resume: --root <dir> is required');

  const root = resolveRoot('resume', values.root);
  const flowName = values.flow;

  const loaded = loadCatalogue();
  if (!loaded.ok) fail(`catalogue: ${loaded.reds.join('; ')}`);
  const catalogue = loaded.primitives;

  const read = readFlow({ root, name: flowName, catalogue });
  if (!read.ok) fail(`flow "${flowName}": ${read.reds.join('; ')}`);
  const { declaration } = read;

  const runIdCheck = resolveRunDir(join(root, flowName), runId);
  if (!runIdCheck.ok) fail(runIdCheck.red);
  const { runDir } = runIdCheck;
  if (!existsSync(runDir)) fail(`resume: no run dir for runId "${runId}" under flow "${flowName}"`);
  // M4e amendment 5 item 3: the cap this run was signed with (its own values file, else the flow's)
  const applied = applyRunValues(read.arbiter, flowName, read.signature.flow, pickRunValues(runDir));
  if (!applied.ok) fail(`resume: ${applied.red}`);
  const { arbiter } = applied;

  const spendPath = join(runDir, 'spend.jsonl');
  let modelStep;
  let ceilingUsd;
  try {
    ({ modelStep, ceilingUsd } = await resolveModelStep(spendPath, env, join(root, flowName), values));
  } catch (err) {
    fail(err.message);
    return;
  }

  // M4d piece 3: the monthly check — the hold is the signed cap minus what this run already spent (its own
  // state.json; no readable figure = the whole cap, never less).
  const priorSpent = Number.isFinite(readRunState(runDir)?.spent) ? readRunState(runDir).spent : 0;
  const hold = takeMonthlyHold({
    what: 'resume', flow: flowName, runId, runDir, holdUsd: Math.max(0, arbiter.capUsd - priorSpent), spentAtHold: priorSpent,
  });

  // Resume never re-freezes inputs — the run's own `inputs.json` (written at
  // park by `freezeInputs`) is the one source of the already-frozen paths a
  // sandboxed primitive may read.
  // F48 round 3: routed through `readFileInside` (`src/flow.js`) — a
  // symlinked `inputs.json` is treated as "no manifest" (empty array) rather
  // than followed, which would otherwise let an outside file's content name
  // arbitrary "frozen" paths for the sandboxed read/grep/readDocx/
  // addressCells tools built just below.
  const inputsManifestRead = readFileInside(runDir, 'inputs.json');
  let inputsManifest = [];
  if (inputsManifestRead.ok) {
    try {
      inputsManifest = JSON.parse(inputsManifestRead.text);
    } catch (err) {
      fail(`resume: inputs.json for run "${runId}" is not valid JSON — ${err.message}`);
      return;
    }
  }
  const allVerbs = [...new Set(declaration.steps.flatMap((s) => s.primitives ?? []))];
  // F46's unwired-verb preflight refusal now lives in `resumeRun` itself
  // (`src/runner.js`) — this CLI no longer keeps a second copy of the check.
  const { tools: primitives, reds: primitiveReds } = resolvePrimitives(catalogue, allVerbs, {
    runDir, inputs: inputsManifest.map((m) => ({ id: m.id, frozen: m.frozen })),
  });

  const result = await resumeRun({
    root,
    name: flowName,
    runId,
    catalogue,
    modelStep,
    ceilingUsd,
    sendStep: sendViaPrimitive,
    primitives,
    primitiveReds,
    businessDate: today(),
    onRerunStart: (d) => hold.nameRunDir(d),
  });

  for (const d of rerunDirs(result, join(root, flowName))) hold.addRunDir(d);
  reportRunResult(result, { rootArg: values.root });
}

// ---------------------------------------------------------------------------
// continue — M4e amendment 4 items 4 and 6: Resume of a STOPPED or CAP-HALTED run (the same run id), under the run's highest signed
// values version (the human's new cap). `fwdloop continue <runId> --flow <name> --root <dir>`. The panel's "Sign & resume" writes
// the new signed version first and then starts this; run by hand it continues under whatever version is on disk.
// ---------------------------------------------------------------------------

async function cmdContinue(rest) {
  const { values, positionals } = parseArgs({
    args: rest,
    options: {
      flow: { type: 'string' },
      root: { type: 'string' },
      model: { type: 'string' }, provider: { type: 'string' },
    },
    allowPositionals: true,
  });
  const env = keyedEnv();
  const runId = positionals[0];
  if (!runId) fail('continue: a runId is required — fwdloop continue <runId> --flow <name> --root <dir>');
  if (!values.flow) fail('continue: --flow <name> is required');
  if (!values.root) fail('continue: --root <dir> is required');

  const root = resolveRoot('continue', values.root);
  const flowName = values.flow;

  const loaded = loadCatalogue();
  if (!loaded.ok) fail(`catalogue: ${loaded.reds.join('; ')}`);
  const catalogue = loaded.primitives;

  const read = readFlow({ root, name: flowName, catalogue });
  if (!read.ok) fail(`flow "${flowName}": ${read.reds.join('; ')}`);
  const { declaration } = read;

  const runIdCheck = resolveRunDir(join(root, flowName), runId);
  if (!runIdCheck.ok) fail(runIdCheck.red);
  const { runDir } = runIdCheck;
  if (!existsSync(runDir)) fail(`continue: no run dir for runId "${runId}" under flow "${flowName}"`);
  const applied = applyRunValues(read.arbiter, flowName, read.signature.flow, pickRunValues(runDir));
  if (!applied.ok) fail(`continue: ${applied.red}`);

  const spendPath = join(runDir, 'spend.jsonl');
  let modelStep;
  let ceilingUsd;
  try {
    ({ modelStep, ceilingUsd } = await resolveModelStep(spendPath, env, join(root, flowName), values));
  } catch (err) {
    fail(err.message);
    return;
  }

  // The monthly check: the hold is the cap in force minus what the run's own books say it has spent (never less than 0).
  const spentSoFar = auditSpend(runDir);
  if (!spentSoFar.ok) fail(`continue: run "${runId}" ${spentSoFar.red}`);
  const hold = takeMonthlyHold({
    what: 'resume', flow: flowName, runId, runDir, holdUsd: Math.max(0, applied.arbiter.capUsd - spentSoFar.total), spentAtHold: spentSoFar.total,
  });

  const inputsManifestRead = readFileInside(runDir, 'inputs.json');
  let inputsManifest = [];
  if (inputsManifestRead.ok) {
    try {
      inputsManifest = JSON.parse(inputsManifestRead.text);
    } catch (err) {
      fail(`continue: inputs.json for run "${runId}" is not valid JSON — ${err.message}`);
      return;
    }
  }
  const allVerbs = [...new Set(declaration.steps.flatMap((s) => s.primitives ?? []))];
  const { tools: primitives, reds: primitiveReds } = resolvePrimitives(catalogue, allVerbs, {
    runDir, inputs: inputsManifest.map((m) => ({ id: m.id, frozen: m.frozen })),
  });

  const result = await continueRun({
    root,
    name: flowName,
    runId,
    catalogue,
    modelStep,
    ceilingUsd,
    sendStep: sendViaPrimitive,
    primitives,
    primitiveReds,
    businessDate: today(),
  });

  for (const d of rerunDirs(result, join(root, flowName))) hold.addRunDir(d);
  reportRunResult(result, { rootArg: values.root });
}

// ---------------------------------------------------------------------------
// panel — M4a piece 2 + M4b (docs/wiki/the-module-ladder.md, "M4a — read-only
// panel" and "M4b — inputs"): `fwdloop panel [--port 4800] [--root <dir>]`.
// Reads are GET/HEAD; the only writes are POST /api/answer and POST
// /api/resume (src/panel/server.js), each gated by Origin/Host. No token, no
// cookie (M4e amendment 4 item 8): `fwdloop panel` prints `http://127.0.0.1:<port>/`.
// Bound to 127.0.0.1 only. Never picks a different port on collision — a taken port is a loud, non-zero-exit
// failure.
// ---------------------------------------------------------------------------

async function cmdPanel(rest) {
  const { values } = parseArgs({
    args: rest,
    options: {
      port: { type: 'string' },
      root: { type: 'string' },
    },
  });
  const root = resolveRoot('panel', values.root ?? '.');

  const argv = ['--root', root];
  if (values.port) argv.push('--port', values.port);

  const code = await panelMain(argv, {
    out: (s) => process.stdout.write(`${s}\n`),
    err: (s) => process.stderr.write(`fwdloop: ${s}\n`),
  });
  process.exitCode = code;
}

// ---------------------------------------------------------------------------
// draft / sign — M6a (docs/wiki/the-module-ladder.md, "M6a — authoring
// backend", scope items 4-5). `draft` is the one paid step and never writes a
// flow; `sign` is the human step ($0) and the only path that writes one.
// Test-only escape hatch for draft, same two-gate shape as resolveModelStep:
// NODE_ENV=test AND FWDLOOP_TEST_DRAFT_PROVIDER (a module whose default export
// returns { provider, rates, modelId }).
// ---------------------------------------------------------------------------

async function cmdDraft(rest) {
  const { values, positionals } = parseArgs({
    args: rest,
    options: {
      out: { type: 'string' }, root: { type: 'string' }, name: { type: 'string' },
      // M4e amendment 24 item 4: the redraft after the human's answers never asks (the panel passes this; a plain draft may ask on try 3)
      'no-questions': { type: 'boolean' },
      // M4d amendment 6: the model that drafts (and then runs) the job - a line ticked in Settings > Providers; --provider only if two keys tick the same id.
      // --thinking is the Chat "Thinking on" tick (drafting only; off unless given).
      model: { type: 'string' }, provider: { type: 'string' }, thinking: { type: 'boolean' },
    },
    allowPositionals: true,
  });
  const keysLoad = keyedLoad();
  const { env } = keysLoad;
  const proseFile = positionals[0];
  if (!proseFile) fail('draft: a prose file is required — fwdloop draft <prose.txt> --out <draftDir> --root <flowsDir> --name <flow>');
  for (const req of ['out', 'root', 'name']) if (!values[req]) fail(`draft: --${req} is required`);

  let injected = {};
  if (process.env.NODE_ENV === 'test' && process.env.FWDLOOP_TEST_DRAFT_PROVIDER) {
    const mod = await import(pathToFileURL(resolve(process.env.FWDLOOP_TEST_DRAFT_PROVIDER)).href);
    injected = await mod.default();
  }
  // The model is named by the caller (a ticked line): refused by name at $0 when it is not. An injected test provider carries its own.
  let pick = {};
  if (injected.provider == null) {
    if (configDoorHome().skip) fail(NO_CONFIG_HOME_REFUSAL);
    try {
      const p = pickTicked(readPriceConfig(), values);
      if (!p.ok) fail(`draft refused at $0 — ${p.say}`);
      pick = { slot: p.slot, model: p.model };
    } catch (err) {
      if (!(err instanceof ConfigError)) throw err;
      fail(`${err.message} — refusing to draft rather than guess the price. Nothing spent.`);
    }
    // The key preflight (draftToDir repeats it).
    const refusal = draftKeyRefusal(pick.slot, env);
    if (refusal !== null) fail(`draft refused at $0 — ${refusal}`);
  } else if (values.model !== undefined) pick = { slot: values.provider, model: values.model };
  // M4d piece 3: the monthly check — a draft has no signed cap, so it holds one ceiling round, priced from the
  // picked model's own Settings prices (an injected test provider carries its own rates). A model that is not
  // ticked with both prices is refused here by name, at $0, before the monthly hold or any draft folder (M4d amendment 5).
  let ceiling;
  try {
    let rates = injected.rates;
    if (!rates) {
      if (configDoorHome().skip) fail(NO_CONFIG_HOME_REFUSAL);
      const usable = resolveUsableModel(pick.slot, { config: readPriceConfig(), model: pick.model });
      if (!usable.ok) fail(`draft refused at $0 — ${usable.say}`);
      rates = usable.rates;
    }
    ceiling = ceilingCostUsd(rates);
  } catch (err) {
    if (!(err instanceof ConfigError)) throw err;
    fail(`${err.message} — refusing to draft rather than guess the price. Nothing spent.`);
  }
  takeMonthlyHold({
    what: 'draft', flow: values.name, runId: null, runDir: resolve(values.out), holdUsd: ceiling,
  });
  const result = await draftToDir({
    proseFile: resolve(proseFile),
    dir: resolve(values.out),
    root: resolve(values.root),
    name: values.name,
    noQuestions: values['no-questions'] === true,
    draftThinking: values.thinking === true ? 'on' : 'off',
    env,
    keyNames: keysLoad.keyNames,
    ...pick,
    ...injected,
  });
  const cost = result.costUsd === null ? 'UNKNOWN' : costText(Number(result.costUsd), result.spendComplete);
  if (!result.wrote) {
    process.stderr.write(`fwdloop: draft refused at $0 — ${result.reds.join('; ')}\n`);
    process.exitCode = 1;
    return;
  }
  process.stdout.write(`draft dir: ${resolve(values.out)}  cost: ${cost}\n`);
  if (!result.ok) {
    process.stderr.write(`fwdloop: draft RED (${result.stop ?? 'scrub'}) — ${result.reds.join('; ')}\n`);
    process.exitCode = 1;
    return;
  }
  if (result.questions > 0) {
    process.stdout.write('DRAFTED — NOT SIGNABLE YET: the plan raised a question. Answer it in the panel (fwdloop panel); the panel drafts again with your answers.\n');
    return;
  }
  process.stdout.write(`${SIGN_LINE(resolve(values.out), result.hash)}\n`);
}

async function cmdSign(rest) {
  const { values, positionals } = parseArgs({
    args: rest,
    options: { approve: { type: 'string' }, 'signed-by': { type: 'string' } },
    allowPositionals: true,
  });
  const keysLoad = keyedLoad(); // sign takes no key, but its leak sweep must know the file's keys too
  const env = keysLoad.env;
  const dir = positionals[0];
  if (!dir) fail('sign: a draft dir is required — fwdloop sign <dir> --approve <hash>');
  // M4e amendments 24/25: a plan with a question is not signed from here — the answers are taken in the panel. One check, also run again inside signDraft.
  const openQuestion = questionsRefusal(resolve(dir));
  if (openQuestion !== null) fail(`sign refused — ${openQuestion}`);
  // Amendment 2: a person at a keyboard. TTY check first (cheapest), then the typed flow name; only then
  // signDraft's own $0 checks (hash, wired, goals, TTL, sources, send, leak). signDraft writes only on success.
  if (!isInteractive()) fail(`sign refused — ${NEEDS_TTY}`);
  let flowName;
  const tj = readFileInside(resolve(dir), 'target.json');
  try { flowName = tj.ok ? JSON.parse(tj.text).name : undefined; } catch { flowName = undefined; }
  if (typeof flowName !== 'string' || flowName === '') fail('sign refused — the draft has no readable target.json name');
  const typed = await confirmTypedName({ name: flowName });
  if (!typed.ok) fail(`sign refused — ${typed.red}`);
  const result = signDraft({
    dir: resolve(dir), approve: values.approve, signedBy: values['signed-by'] ?? userInfo().username, env, keyNames: keysLoad.keyNames,
  });
  if (!result.ok) fail(`sign refused — ${result.reds.join('; ')}`);
  process.stdout.write(`signed: ${result.flowDir} (by ${result.signature.signedBy})\n`);
}

// ---------------------------------------------------------------------------

async function main() {
  const [verb, ...rest] = process.argv.slice(2);
  if (!verb) fail('usage: fwdloop draft|sign|run|inbox|show|answer|resume|continue|panel ...');

  if (verb === 'draft') return cmdDraft(rest);
  if (verb === 'sign') return cmdSign(rest);
  if (verb === 'run') return cmdRun(rest);
  if (verb === 'inbox') return cmdInbox(rest);
  if (verb === 'show') return cmdShow(rest);
  if (verb === 'answer') return cmdAnswer(rest);
  if (verb === 'resume') return cmdResume(rest);
  if (verb === 'continue') return cmdContinue(rest);
  if (verb === 'panel') return cmdPanel(rest);
  fail(`unknown verb "${verb}" — expected draft | sign | run | inbox | show | answer | resume | continue | panel`);
  return undefined;
}

main().catch((err) => {
  process.stderr.write(`fwdloop: ${err.message}\n`);
  process.exit(1);
});
